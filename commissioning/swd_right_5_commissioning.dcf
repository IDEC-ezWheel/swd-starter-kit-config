[1029]
ParameterName=Error behaviour
ObjectType=8
SubNumber=4
;;If a serious CANopen device failure is detected in NMT state Operational, the CANopen device shall
;;enter by default autonomously the NMT state Pre-operational. If the object is implemented, the
;;CANopen device is configurable to enter alternatively the NMT state Stopped or remain in the current
;;NMT state. CANopen device failures shall include the following communication errors:
;;• Bus-off conditions of the CAN interface
;;• Life guarding event with the state ‘occurred’ and the reason time out
;;• Heartbeat event with state ‘occurred’ and the reason "time out"
;;Severe CANopen device errors also may be caused by CANopen device internal failures.

[1029sub0]
ParameterName=error_behaviour_highest_sub_index
ObjectType=7
DataType=5
AccessType=const
PDOMapping=0
DefaultValue=3
LowLimit=0
HighLimit=254

[1029sub1]
ParameterName=error_behaviour_communication_error
ObjectType=7
DataType=5
AccessType=rw
PDOMapping=0
ParameterValue=0
LowLimit=0
HighLimit=255

[1029sub2]
ParameterName=error_behaviour_syserr_for_error
ObjectType=7
DataType=5
AccessType=rw
PDOMapping=0
ParameterValue=1
LowLimit=0
HighLimit=255

[1029sub3]
ParameterName=error_behaviour_syserr_for_warning
ObjectType=7
DataType=5
AccessType=rw
PDOMapping=0
ParameterValue=1
LowLimit=0
HighLimit=255

