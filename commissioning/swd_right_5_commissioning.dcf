[2660]
ParameterName=Brake present
ObjectType=7
DataType=1
AccessType=rw
PDOMapping=0
ParameterValue=0
LowLimit=0
HighLimit=1
;;This object shall be used to configure if an external brake is used on the product.
;;A value of TRUE indicates that an external brake is intended to be connected on the brake connector of the product,
;;while a value of FALSE indicates that no external brake shall be connected.
;;Upon transitionning to OPERATION_ENABLED, the product will check the external brake presence according to this object.
;;This parameter limits the available SBC modes to:
;;- when TRUE: SBC_0, SBC_1, SBC_2
;;- when FALSE: SBC_0, SBC_3

