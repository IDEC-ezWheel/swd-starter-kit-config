[1005]
ParameterName=COB ID SYNC message
ObjectType=7
DataType=7
AccessType=rw
PDOMapping=0
DefaultValue=0x00000080
ParameterValue=0x80
LowLimit=128
HighLimit=4294967295
;;This object shall indicate the configured COB-ID of the synchronization object (SYNC). Further, it
;;defines whether the CANopen device generates the SYNC.
;;

[1008]
ParameterName=Manufacturer device name
ObjectType=7
DataType=9
AccessType=const
PDOMapping=0
DefaultValue=EZ-Wheel
;;This object shall provide the name of the device as given by the manufacturer

[1009]
ParameterName=Manufacturer hardware version
ObjectType=7
DataType=9
AccessType=const
PDOMapping=0
