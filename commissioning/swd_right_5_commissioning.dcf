ParameterValue=50
LowLimit=0
HighLimit=4294967295
;;Configure motor control PID, derivative gain

[2158]
ParameterName=motctrl_speed_pid_tw
ObjectType=7
DataType=7
AccessType=rw
PDOMapping=0
ParameterValue=316
;;Configure motor control PID, integral anti-windup time constant.
;;Common value: sqrt(kd / ki).
;;Implementation is: Tw = motctrl_speed_pid_tw / 1000.
;;Example: to set Tw to 0.316, write 316 in motctrl_speed_pid_tw.

[2159]
ParameterName=motctrl_speed_pid_tn
ObjectType=7
DataType=7
AccessType=rw
PDOMapping=0
ParameterValue=600
;;Configure motor control PID, derivative filter time constant.
;;Implementation is: Tn = motctrl_speed_pid_tn / 1000.
;;Example: to set Tn to 0.6, write 600 in motctrl_speed_pid_tn.

