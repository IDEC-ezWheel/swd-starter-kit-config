[6830]
ParameterName=Speed value
ObjectType=8
SubNumber=5
;;This object shall provide the output speed value(s). For linear encoders the speed-measuring
;;step is defined in object 6005h, sub-index 02h. The speed value for rotary encoders shall be
;;given in multiples of measuring units per second. This object is only mandatory for multisensor
;;encoders (object 1000h encoder type: code 10d).

[6830sub0]
ParameterName=Highest sub index supported
ObjectType=7
DataType=5
AccessType=ro
PDOMapping=0
DefaultValue=4
LowLimit=1
HighLimit=254

[6830sub1]
