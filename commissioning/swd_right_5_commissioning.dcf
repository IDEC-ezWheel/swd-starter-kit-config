DefaultValue=$NODEID+0x00000080
ParameterValue=133
;;This object shall indicate the configured COB-ID for the EMCY write service.

[1017]
ParameterName=Producer Heartbeat Time
ObjectType=7
DataType=6
AccessType=rw
PDOMapping=0
DefaultValue=500
LowLimit=0
HighLimit=65535
;;The producer heartbeat time shall indicate the configured cycle time of the heartbeat produced by the device.
;;
;;The value shall be given in multiples of 1 ms. The value 0 shall disable the producer heartbeat.
;;

[1018]
ParameterName=Identity Object
ObjectType=9
SubNumber=5
;;This object shall provide general identification information of the CANopen device.

[1018sub0]
ParameterName=Number of entries
ObjectType=7
DataType=5
AccessType=const
PDOMapping=0
DefaultValue=4
LowLimit=1
HighLimit=4

[1018sub1]
ParameterName=Vendor Id
ObjectType=7
DataType=7
AccessType=ro
PDOMapping=0
DefaultValue=0x00000515
LowLimit=0
HighLimit=4294967295

[1018sub2]
ParameterName=Product Code
ObjectType=7
DataType=7
AccessType=ro
PDOMapping=0
LowLimit=0
HighLimit=4294967295
;;This object indicates the product ID of the SWD.
;;When 0, no product ID was found in the product, else:
;;
;;ezSWDcore.0/C       1
;;ezSWDcore.4/C       2
;;ezSWDcore.14/C      3
;;ezSWDcore.25/C      4
;;ezSWDcore.50/C      5
;;ezSWDcore.100/C     6
;;
;;ezSWD125IM.4/C      7
;;ezSWD125IM.4/C_PRO  8
;;ezSWD125IM.14/C     9
;;ezSWD125IM.25/C     10
;;
;;ezSWDcore.0B/C      11
;;ezSWDcore.4B/C      12
;;ezSWDcore.14B/C     13
;;ezSWDcore.25B/C     14
;;ezSWDcore.50B/C     15
;;ezSWDcore.100B/C    16
;;
;;ezSWD125IM.4B/C     17
;;ezSWD125IM.14B/C    18
;;ezSWD125IM.25B/C    19
;;
;;ezSWD150IH.14/C-0   20
;;ezSWD150IH.25/C-0   21
;;ezSWD150IH.14/C-1   22
;;ezSWD150IH.25/C-1   23
;;
;;ezSWD150IH.14B/C-0  24
;;ezSWD150IH.25B/C-0  25
;;ezSWD150IH.14B/C-1  26
;;ezSWD150IH.25B/C-1  27
;;
;;ezSWD200IH.14/C-0   28
;;ezSWD200IH.25/C-0   29
;;ezSWD200IH.14/C-1   30
;;ezSWD200IH.25/C-1   31
;;
;;ezSWD200IH.14B/C-0  32
;;ezSWD200IH.25B/C-0  33
;;ezSWD200IH.14B/C-1  34
;;ezSWD200IH.25B/C-1  35
;;
;;E_202777_SMC_GM     36
;;E_202727_SMC_GN2    37

